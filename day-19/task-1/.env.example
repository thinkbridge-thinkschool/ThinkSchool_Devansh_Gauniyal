# Copy this file to .env (gitignored) and fill in real values before running the emulator locally.
# Never commit the real .env file.

# Any strong password satisfying SQL Server's password policy. This is a throwaway
# credential for a local, ephemeral SQL Server container that backs the emulator only.
MSSQL_SA_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD

# Pass "Y" to accept the Service Bus emulator and SQL Server Linux EULAs.
ACCEPT_EULA=N

# The application connection string. For the local emulator this is a fixed, publicly
# documented value (see README.md) — not a real secret — but it is still kept out of
# tracked files and supplied only via environment variable / dotnet user-secrets, exactly
# as a real Azure Service Bus connection string (which DOES contain a real SharedAccessKey)
# must be.
SERVICEBUS_CONNECTION_STRING=REPLACE_WITH_EMULATOR_OR_REAL_CONNECTION_STRING
