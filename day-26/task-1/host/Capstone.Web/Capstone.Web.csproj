<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Invoicing\Capstone.Invoicing.Infrastructure\Capstone.Invoicing.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Modules\Procurement\Capstone.Procurement.Infrastructure\Capstone.Procurement.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Day 26 - OpenTelemetry -> Azure Monitor. Every version below was confirmed live
    against the NuGet v3-flatcontainer API on 2026-09-10 (latest non-preview at that
    date), not written from memory - see capstone/infra/README.md, "Day 26 - exact
    package versions and how they were verified".
  -->
  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.18.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <!--
      Day 26 - what actually broke: Microsoft.Data.SqlClient 7.x moved Entra ID
      (Active Directory) authentication providers - including
      "Authentication=Active Directory Managed Identity", the mode
      infra/modules/api.bicep's connection string uses - out of the base package
      and into this extension. Without it, SqlConnection.OpenAsync() throws
      System.ArgumentException: "Cannot find an authentication provider for
      'ActiveDirectoryManagedIdentity'" at the FIRST real connection attempt -
      exactly the "no proof of a live TDS query" gap Day 25 named and left open.
      Confirmed live against the deployed app's own exception (see
      infra/README.md's verification log) before adding this, not assumed from
      the package's release notes.
    -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.0.2" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    No OpenAPI/Swagger package: the default webapi template pulled in
    Microsoft.AspNetCore.OpenApi, which transitively brings a Microsoft.OpenApi
    version with a known high-severity advisory (GHSA-v5pm-xwqc-g5wc). This host
    doesn't expose a real API surface yet (design + scaffold task), so the
    dependency was removed rather than accepted.
  -->

</Project>
